{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist",
    "public/pagefind",
    "**/*_copy*",
    "**/*.old",
    "generate-perfect-config.mjs",
    "test-*",
    "tests"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/astro-paper.config": [
        "./astro-paper.config"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
