    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@puckeditor/core": "^0.22.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.0.3",
    "dayjs": "^1.11.21",
    "hono": "^4.12.33",
    "lodash.kebabcase": "^4.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
