{
  "name": "astro-paper-v6",
  "type": "module",
  "version": "6.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev dist",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "generate-types": "wrangler types",
    "deploy": "npm run build && rm -rf dist/server/wrangler.json .wrangler/deploy && cp -r dist/client/* dist/ && echo \"export { default } from './server/entry.mjs';\" > dist/_worker.js && npx wrangler pages deploy dist --project-name cmsmu --branch main"
  },
  "dependencies": {
