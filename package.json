{
  "name": "cmsmu",
  "type": "module",
  "version": "0.1.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build:all",
    "build:all": "turbo run build",
    "check:types": "turbo run check-types",
    "check:packages": "tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p apps/cms-api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "ci:check": "pnpm run lint && pnpm run format:check && pnpm run check:packages && pnpm run build:all",
    "dev:all": "turbo run dev",
    "dev:api": "turbo run dev --filter=@cmsmu/cms-api",
    "dev:web": "turbo run dev --filter=@cmsmu/web",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "generate-types": "wrangler types",
    "predeploy": "node scripts/verify-deploy-sync.mjs",
    "deploy:staging-newsroom": "node scripts/deploy-staging-newsroom.mjs",
    "deploy": "pnpm run deploy:web",
    "deploy:api": "turbo run deploy --filter=@cmsmu/cms-api",
    "deploy:web": "turbo run deploy --filter=@cmsmu/web",
    "release:git": "node scripts/push-to-git-upstream.mjs",
    "setup": "node scripts/setup-cloud.mjs",
    "install:cloud": "node scripts/setup-cloud.mjs",
    "sync:client": "node scripts/sync-core-to-client.mjs",
    "sync:client:dry": "node scripts/sync-core-to-client.mjs --dry-run",
    "commit:modular": "node scripts/commit-modular.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cmsmu/plugin-agens": "workspace:*",
    "@cmsmu/plugin-emagazine": "workspace:*",
    "@cmsmu/plugin-subscribers": "workspace:*",
    "@cloudflare/workers-types": "^5.20260801.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "wrangler": "^4.118.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.62.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "prettier": "3.9.3",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
