{
  "name": "cmsmu",
  "type": "module",
  "version": "0.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:all": "turbo run build",
    "check:packages": "tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p apps/cms-api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "dev:all": "turbo run dev",
    "preview": "npm run build && wrangler pages dev dist",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "generate-types": "wrangler types",
    "deploy": "npm run build && rm -rf dist/server/wrangler.json .wrangler/deploy && cp -r dist/client/* dist/ && echo \"export { default } from './server/entry.mjs';\" > dist/_worker.js && npx wrangler pages deploy dist --project-name cmsmu --branch main",
    "setup": "node scripts/setup-cloud.mjs",
    "install:cloud": "node scripts/setup-cloud.mjs",
    "sync:client": "node scripts/sync-core-to-client.mjs",
    "sync:client:dry": "node scripts/sync-core-to-client.mjs --dry-run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@puckeditor/core": "^0.22.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.0.3",
    "aws4fetch": "^1.0.20",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "jsdom": "^29.1.1",
    "lodash.kebabcase": "^4.1.1",
    "lucide-react": "^1.28.0",
    "puppeteer": "^25.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.2",
    "wrangler": "^4.118.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.62.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "pagefind": "^1.5.2",
    "prettier": "3.9.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
