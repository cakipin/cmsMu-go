{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "cmsmu",
	"pages_build_output_dir": "./dist",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cmsmu-db",
			"database_id": "cf808b94-8328-478d-b5db-f0ad5a01be44"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "labmu-cms-dev"
		},
		{
			"binding": "BUCKET",
			"bucket_name": "labmu-cms-dev"
		}
	],
	"kv_namespaces": [
		{
			"binding": "WIKIMU_CACHE",
			"id": "888371371c0c41c88d3d474fed476f70"
		},
		{
			"binding": "SESSION",
			"id": "72fcc89c00b0401283439ff7f50f912e"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	}
}