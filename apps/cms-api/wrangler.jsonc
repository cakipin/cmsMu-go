{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-staging-newsroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api-staging-newsroom.labmu.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cmsmu-db",
      "database_id": "cf808b94-8328-478d-b5db-f0ad5a01be44"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "labmu-cms-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "72fcc89c00b0401283439ff7f50f912e"
    }
  ]
}
