{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "../../packages/ui/worker-configuration.d.ts"],
  "exclude": ["dist", "public/pagefind"],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/astro-paper.config": ["./astro-paper.config"],
      "@cmsmu/cms-api/modules/theme-builder": [
        "../cms-api/src/modules/theme-builder/index.ts"
      ],
      "@cmsmu/cms-api/modules/theme-builder/*": [
        "../cms-api/src/modules/theme-builder/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
