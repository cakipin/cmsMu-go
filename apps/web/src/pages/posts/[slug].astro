---
export const prerender = false;

import { getDb, posts as postsTable, settings as settingsTable } from '@cmsmu/db';
import { eq, or } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import '@cmsmu/ui/tokens.css';

const { slug } = Astro.params;
const d1 = env?.DB;

let article: any = null;
let siteTitle = 'CMSMu';

if (d1 && slug) {
  try {
    const db = getDb(d1);
    const settingsRows = await db.select().from(settingsTable);
    for (const row of settingsRows) {
      if (row.key === 'site_title' && row.value) siteTitle = row.value;
    }

    const numId = parseInt(slug, 10);
    const query = !isNaN(numId)
      ? db.select().from(postsTable).where(or(eq(postsTable.slug, slug), eq(postsTable.id, numId)))
      : db.select().from(postsTable).where(eq(postsTable.slug, slug));

    article = await query.get();
  } catch (e) {
    console.error('Error fetching article:', e);
  }
}
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{article ? `${article.title} - ${siteTitle}` : `Artikel Tidak Ditemukan - ${siteTitle}`}</title>
  <meta name="description" content={article?.excerpt || article?.title || siteTitle} />
  <style>
    body {
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      margin: 0;
      padding: 0;
      line-height: 1.6;
    }
    .header-bar {
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 1rem 1.5rem;
    }
    .brand-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
      text-decoration: none;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      color: var(--accent-primary);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }
    .back-link:hover {
      text-decoration: underline;
    }
    .badge {
      display: inline-block;
      padding: 0.25rem 0.6rem;
      border-radius: 0.375rem;
      font-size: 0.8rem;
      font-weight: 600;
      background-color: var(--accent-badge);
      color: var(--accent-primary);
      margin-bottom: 0.75rem;
    }
    .article-title {
      font-size: 2.25rem;
      font-weight: 800;
      line-height: 1.25;
      margin: 0 0 1rem 0;
      color: var(--text-primary);
    }
    .article-meta {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 1rem;
    }
    .featured-img {
      width: 100%;
      max-height: 440px;
      object-fit: cover;
      border-radius: 0.75rem;
      margin-bottom: 2rem;
      background-color: var(--border-subtle);
    }
    .article-content {
      font-size: 1.1rem;
      color: var(--text-primary);
      line-height: 1.8;
    }
    .not-found {
      padding: 4rem 2rem;
      text-align: center;
      background-color: var(--bg-surface);
      border: 1px dashed var(--border-subtle);
      border-radius: 0.75rem;
    }
    footer {
      border-top: 1px solid var(--border-subtle);
      padding: 2rem 1.5rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
      margin-top: 4rem;
    }
  </style>
</head>
<body>
  <header class="header-bar">
    <a href="/" class="brand-title">{siteTitle}</a>
  </header>

  <main class="container">
    <a href="/" class="back-link">&larr; Kembali ke Beranda</a>

    {!article ? (
      <div class="not-found">
        <h2>Artikel Tidak Ditemukan</h2>
        <p>Maaf, artikel yang Anda tuju mungkin telah dihapus atau tidak tersedia.</p>
        <a href="/" class="back-link">Kembali ke Halaman Utama</a>
      </div>
    ) : (
      <article>
        {article.category && <span class="badge">{article.category}</span>}
        <h1 class="article-title">{article.title}</h1>
        <div class="article-meta">
          <span>Ditulis oleh <strong>{article.author || 'Redaksi'}</strong></span>
        </div>

        {article.featuredImage && (
          <img src={article.featuredImage} alt={article.title} class="featured-img" />
        )}

        <div class="article-content" set:html={article.body || article.excerpt || ''} />
      </article>
    )}
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} {siteTitle}. Didukung oleh CMSMu Serverless Edge Framework.</p>
  </footer>
</body>
</html>
