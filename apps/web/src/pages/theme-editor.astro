---
// Halaman Visual Page Builder cmsMu Canvas (Zero External Dependency)
import CmsMuCanvasApp from "../components/builder/CmsMuCanvasApp";

export const prerender = false;

import "@/styles/global.css";

// Ambil slug dari query params
const slug = Astro.url.searchParams.get("slug") || "home";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>cmsMu Canvas Visual Builder - {slug}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-900 m-0 p-0 overflow-hidden">
    <!-- Render aplikasi cmsMu Native Canvas Visual Builder -->
    <CmsMuCanvasApp client:only="react" slug={slug} />
  </body>
</html>
