---
export const prerender = false;

import { getDb, posts as postsTable, settings as settingsTable } from '@cmsmu/db';
import { eq, desc } from 'drizzle-orm';
import '@cmsmu/ui/tokens.css';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
let siteTitle = 'CMSMu Universal Reader';
let siteDescription = 'Portal Berita & Konten Digital Berbasis Cloudflare Edge';
let articles: any[] = [];
let categories: string[] = [];

if (d1) {
  try {
    const db = getDb(d1);
    const settingsRows = await db.select().from(settingsTable);
    for (const row of settingsRows) {
      if (row.key === 'site_title' && row.value) siteTitle = row.value;
      if (row.key === 'site_description' && row.value) siteDescription = row.value;
    }

    articles = await db.select({
      id: postsTable.id,
      title: postsTable.title,
      slug: postsTable.slug,
      excerpt: postsTable.excerpt,
      category: postsTable.category,
      featuredImage: postsTable.featuredImage,
      author: postsTable.author,
      createdAt: postsTable.createdAt
    })
    .from(postsTable)
    .where(eq(postsTable.status, 'publish'))
    .orderBy(desc(postsTable.createdAt))
    .limit(12);

    const catSet = new Set<string>();
    for (const a of articles) {
      if (a.category) catSet.add(a.category);
    }
    categories = Array.from(catSet);
  } catch (e) {
    console.error('Error fetching data in apps/web index:', e);
  }
}
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  <meta name="description" content={siteDescription} />
  <style>
    body {
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      margin: 0;
      padding: 0;
    }
    .header-bar {
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
      text-decoration: none;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .hero-section {
      margin-bottom: 2.5rem;
    }
    .hero-title {
      font-size: 2rem;
      font-weight: 800;
      margin: 0 0 0.5rem 0;
      color: var(--text-primary);
    }
    .hero-desc {
      color: var(--text-secondary);
      font-size: 1.1rem;
      margin: 0;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }
    .card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.75rem;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }
    .card-img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background-color: var(--border-subtle);
    }
    .card-body {
      padding: 1.25rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .card-badge {
      display: inline-block;
      align-self: flex-start;
      padding: 0.2rem 0.5rem;
      border-radius: 0.375rem;
      font-size: 0.75rem;
      font-weight: 600;
      background-color: var(--accent-badge);
      color: var(--accent-primary);
      margin-bottom: 0.75rem;
    }
    .card-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 0.5rem 0;
      line-height: 1.4;
    }
    .card-excerpt {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin: 0 0 1rem 0;
      line-height: 1.5;
      flex: 1;
    }
    .card-meta {
      font-size: 0.8rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.75rem;
    }
    .empty-state {
      padding: 3rem;
      text-align: center;
      background-color: var(--bg-surface);
      border: 1px dashed var(--border-subtle);
      border-radius: 0.75rem;
      color: var(--text-secondary);
    }
    footer {
      border-top: 1px solid var(--border-subtle);
      padding: 2rem 1.5rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
      margin-top: 3rem;
    }
  </style>
</head>
<body>
  <header class="header-bar">
    <a href="/" class="brand-title">{siteTitle}</a>
    <nav>
      {categories.map((cat) => (
        <span class="card-badge" style="margin-left: 0.5rem;">{cat}</span>
      ))}
    </nav>
  </header>

  <main class="container">
    <section class="hero-section">
      <h1 class="hero-title">{siteTitle}</h1>
      <p class="hero-desc">{siteDescription}</p>
    </section>

    {articles.length === 0 ? (
      <div class="empty-state">
        <p>Belum ada artikel publikasi yang tersedia di database.</p>
      </div>
    ) : (
      <div class="grid">
        {articles.map((article) => (
          <a href={`/posts/${article.slug || article.id}`} class="card">
            {article.featuredImage ? (
              <img src={article.featuredImage} alt={article.title} class="card-img" loading="lazy" />
            ) : (
              <div class="card-img" style="display:flex;align-items:center;justify-content:center;color:var(--text-muted);">
                <span>No Image</span>
              </div>
            )}
            <div class="card-body">
              {article.category && <span class="card-badge">{article.category}</span>}
              <h2 class="card-title">{article.title}</h2>
              <p class="card-excerpt">{article.excerpt || 'Baca selengkapnya artikel ini...'}</p>
              <div class="card-meta">
                <span>Oleh {article.author || 'Redaksi'}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} {siteTitle}. Didukung oleh CMSMu Serverless Edge Framework.</p>
  </footer>
</body>
</html>
