// src/themes/labmu-quran/index.ts
import { ThemeStructure, ThemeContext } from '../types';
import { css } from './style';
import { renderHeader } from './header';
import { renderFooter } from './footer';
import { QuranTopics } from './topics';

const LabMuQuran: ThemeStructure = {
  name: 'LabMu Quran Ultimate KHGT (Calibrated)',
  version: '21.0-KHGT-16',
  author: 'LabMu',

  _layout(content: string, title: string, ctx: ThemeContext) {
    return `
      <!DOCTYPE html>
      <html lang="id">
      <head>
        <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${title} - QuranMu</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <style>${css}</style>
      </head>
      <body>
        ${renderHeader(ctx)}
        <div class="quran-container">
          <div class="content-area">${content}</div>
          ${renderFooter(ctx)}
        </div>
        ${this._scripts()}
      </body>
      </html>
    `;
  },

  _scripts() {
    return `
      <div id="toast" style="visibility:hidden; min-width:200px; background:#333; color:#fff; text-align:center; border-radius:8px; padding:10px; position:fixed; z-index:9999; left:50%; bottom:90px; transform:translateX(-50%); opacity:0; transition:0.3s;">Copied!</div>

      <script>
        var state = {
            dark: null === 'true',
            latin: null !== 'false',
            id: null !== 'false',
            en: null === 'true',
            qari: null || '05',
            qariName: null || 'Misyari Rasyid'
        };

        // --- RUMUS KUWAITI (DENGAN KALIBRASI KHGT) ---
        function getHijriString() {
            var today = new Date();
            var day = today.getDate();
            var month = today.getMonth();
            var year = today.getFullYear();
            var m = month + 1;
            var y = year;

            if (m < 3) { y -= 1; m += 12; }

            var a = Math.floor(y / 100);
            var b = 2 - a + Math.floor(a / 4);
            if (y < 1583) b = 0;
            if (y == 1582) {
                if (m > 10) b = -10;
                if (m == 10) {
                    b = 0;
                    if (day > 4) b = -10;
                }
            }

            var jd = Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + day + b - 1524;

            b = 0;
            if (jd > 2299160) {
                a = Math.floor((jd - 1867216.25) / 36524.25);
                b = 1 + a - Math.floor(a / 4);
            }
            var bb = jd + b + 1524;
            var cc = Math.floor((bb - 122.1) / 365.25);
            var dd = Math.floor(365.25 * cc);
            var ee = Math.floor((bb - dd) / 30.6001);
            day = (bb - dd) - Math.floor(30.6001 * ee);
            month = ee - 1;
            if (ee > 13) {
                cc += 1;
                month = ee - 13;
            }
            year = cc - 4716;

            var iyear = 10631.0 / 30.0;
            var epochastro = 1948084;
            var shift1 = 8.01 / 60.0;

            var z = jd - epochastro;
            var cyc = Math.floor(z / 10631.0);
            z = z - 10631 * cyc;
            var j = Math.floor((z - shift1) / iyear);
            var iy = 30 * cyc + j;
            z = z - Math.floor(j * iyear + shift1);
            var im = Math.floor((z + 28.5001) / 29.5);
            if (im == 13) im = 12;
            var id = z - Math.floor(29.5001 * im - 29);

            var iMonthNames = ["Muharram","Safar","Rabi'ul Awal","Rabi'ul Akhir",
            "Jumadil Awal","Jumadil Akhir","Rajab","Sya'ban",
            "Ramadhan","Syawal","Dzulkaidah","Dzulhijjah"];

            // --- KALIBRASI KHGT ---
            // Ubah angka ini untuk geser tanggal
            // 0 = Standar
            // -1 = Mundur 1 hari (17 jadi 16)
            // 1 = Maju 1 hari
            var adjustment = -1;

            var finalDay = id + adjustment;

            // Handle jika tanggal jadi 0 atau minus (mundur bulan) - Sederhana
            if (finalDay <= 0) {
                 // Logika sederhana: anggap bulan sebelumnya 30 hari
                 finalDay = 30 + finalDay;
                 im = im - 1;
                 if(im < 1) { im = 12; iy = iy - 1; }
            }

            return finalDay + " " + iMonthNames[im - 1] + " " + iy;
        }

        function updateHijriDate() {
            try {
                // 1. Ambil Hijriah dengan Kalibrasi KHGT (-1 hari)
                var hijri = getHijriString();

                // 2. Ambil Masehi
                var tgl = new Date();
                var masehi = tgl.toLocaleDateString('id-ID', {
                    day: 'numeric', month: 'long', year: 'numeric'
                });

                // 3. Inject ke HTML
                var bD = document.getElementById('hijri-badge-desktop');
                if (bD) {
                    bD.innerHTML = '<div class="calendar-khgt">' + hijri + ' H</div>' +
                                   '<div class="calendar-divider"></div>' +
                                   '<div class="calendar-masehi">' + masehi + '</div>';
                }

                var bM = document.getElementById('hijri-badge-mobile');
                if (bM) {
                    bM.innerHTML = '<div style="font-weight:bold; color:var(--primary); font-size:1rem;">' + hijri + ' H</div>' +
                                   '<div style="font-size:0.75rem; opacity:0.8; margin-top:3px;">' + masehi + '</div>';
                }
            } catch (e) { console.error("Error Kalender:", e); }
        }

        function updateUI() {
            document.body.className = state.dark ? 'dark' : '';
            ['latin', 'id', 'en'].forEach(function(k) {
                document.body.classList.toggle('show-' + k, state[k]);
                var btn = document.getElementById('btn-' + k);
                var btnM = document.getElementById('btn-' + k + '-m');
                if(btn) btn.classList.toggle('active', state[k]);
                if(btnM) btnM.classList.toggle('active', state[k]);
            });
            var qLabel = document.getElementById('qari-label-desktop');
            if(qLabel) qLabel.innerText = state.qariName.split(' ')[0];
        }

        function toggleMode(key) {
            if(key === 'theme') { state.dark = !state.dark; (void 0); }
            else { state[key] = !state[key]; (void 0); }
            updateUI();
        }

        function toggleSidebar() {
            var sb = document.getElementById('mobile-sidebar');
            var ov = document.getElementById('sidebar-overlay');
            if(sb) sb.classList.toggle('open');
            if(ov) ov.classList.toggle('show');
        }

        function toggleQariMenu() {
            var list = document.getElementById('qari-list');
            if(list) list.classList.toggle('show');
        }

        function selectQari(val, name) {
            state.qari = val; state.qariName = name;
            (void 0); (void 0);
            updateUI(); toggleQariMenu();
        }

        function selectQariMobile(val) {
            var select = document.getElementById('qari-select-mobile');
            selectQari(val, select.options[select.selectedIndex].text);
        }

        function playAyat(btn, title) {
            var url = btn.getAttribute('data-url-' + state.qari);
            if(!url || url === 'undefined') url = btn.getAttribute('data-url-05');
            if(url) {
                document.getElementById('player-container').style.display = 'flex';
                document.getElementById('player-title').innerText = title;
                var p = document.getElementById('main-player'); p.src = url; p.play();
            } else { showToast('Audio tidak tersedia'); }
        }

        function closePlayer() {
            var p = document.getElementById('main-player');
            if(p) p.pause();
            document.getElementById('player-container').style.display='none';
        }

        function showToast(msg) {
            var x=document.getElementById("toast");
            x.innerText=msg; x.style.visibility="visible"; x.style.opacity="1";
            setTimeout(()=>{x.style.visibility="hidden";x.style.opacity="0";},2000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateUI();
            updateHijriDate();
        });
      </script>

      <div class="sticky-player" id="player-container" style="display:none;">
          <div style="width:35px; height:35px; background:var(--primary); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff;"><i class="fas fa-play"></i></div>
          <div style="flex:1; overflow:hidden;">
             <span id="player-title" style="font-size:0.75rem; font-weight:bold; color:var(--text-main); display:block; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">Audio</span>
             <audio id="main-player" controls style="height:30px; width:100%;"></audio>
          </div>
          <button onclick="closePlayer()" style="background:none; border:none; color:var(--text-muted); cursor:pointer;"><i class="fas fa-times"></i></button>
      </div>
    `;
  },

  renderHome(ctx: ThemeContext) {
    const list = Array.isArray(ctx.data) ? ctx.data : [];
    const topicsJson = typeof QuranTopics !== 'undefined' ? JSON.stringify(QuranTopics) : '[]';

    return this._layout(`
      <div style="text-align:center; padding:30px 0;">
        <h1 style="font-family:'Amiri', serif; font-size:2.8rem; color:var(--primary); margin:0;">Al-Quran Digital</h1>
        <p style="color:var(--text-muted); margin-top:5px;">Cari Surat atau Tema (cth: "Sabar", "Hutang")</p>
      </div>

      <div style="position:relative; margin-bottom:30px; z-index:10;">
          <input type="text" id="searchBox" placeholder="Ketik nama surat atau tema..." class="search-box" onkeyup="handleSearch()" autocomplete="off" style="width:100%; padding:15px; border-radius:12px; border:1px solid var(--border); background:var(--bg-card); color:var(--text-main);">
          <i class="fas fa-search" style="position:absolute; right:15px; top:18px; color:#ccc;"></i>
      </div>

      <div id="topicResult" style="display:none; margin-bottom:30px;">
          <h3 style="font-size:0.9rem; color:var(--primary); font-weight:bold; margin-bottom:12px;">✨ Hasil Tematik Relevan:</h3>
          <div id="topicList" style="display:grid; gap:15px;"></div>
      </div>

      <div class="surat-grid" id="suratGrid">
        ${list.map((s: any) => `
          <a href="/${s.nomor}" class="surat-card" data-name="${s.namaLatin.toLowerCase()} ${s.arti.toLowerCase()}">
            <div class="nomor-surat">${s.nomor}</div>
            <div style="flex:1;">
              <div style="font-weight:bold;">${s.namaLatin}</div>
              <div style="font-size:0.85rem; color:var(--text-muted);">${s.arti} • ${s.jumlahAyat} Ayat</div>
            </div>
            <div style="font-family:'Amiri', serif; font-size:1.4rem; color:var(--primary);">${s.nama}</div>
          </a>`).join('')}
      </div>

      <script>
        var allTopics = ${topicsJson};
        function handleSearch() {
            var keyword = document.getElementById('searchBox').value.toLowerCase().trim();
            var tBox = document.getElementById('topicResult');
            var tList = document.getElementById('topicList');
            var cards = document.querySelectorAll('.surat-card');

            cards.forEach(function(el) {
                var name = el.getAttribute('data-name');
                el.style.display = (keyword === '' || name.includes(keyword)) ? 'flex' : 'none';
            });

            if (keyword.length > 2) {
                var matches = allTopics.filter(function(t) {
                    return t.title.toLowerCase().includes(keyword) ||
                           (t.keywords && t.keywords.some(function(k) { return k.toLowerCase().includes(keyword); }));
                });

                if (matches.length > 0) {
                    tBox.style.display = 'block';
                    tList.innerHTML = matches.map(function(t) {
                        var links = t.verses.map(function(v) {
                            return '<a href="/' + v.s + '#ayat-' + v.a + '" class="topic-pill" style="text-decoration:none; font-size:0.8rem; padding:8px 12px; display:inline-block; margin:2px; background:var(--primary); color:#fff; border-radius:20px;">' + v.text + '</a>';
                        }).join('');
                        return '<div style="background:var(--bg-card); border:1px solid var(--primary); padding:15px; border-radius:12px;">' +
                               '<strong style="color:var(--text-main); font-size:1.1rem; display:block; margin-bottom:10px;">' + (t.icon || '📖') + ' ' + t.title + '</strong>' +
                               '<div style="display:flex; flex-wrap:wrap; gap:5px;">' + links + '</div></div>';
                    }).join('');
                } else { tBox.style.display = 'none'; }
            } else { tBox.style.display = 'none'; }
        }
      </script>
    `, 'Beranda', ctx);
  },

  renderSingle(ctx: ThemeContext) {
    const s = ctx.data;
    if (!s || !s.ayat) return this._layout('<div style="text-align:center;padding:100px;"><h1>Not Found</h1></div>', 'Error', ctx);

    const ayatListHtml = s.ayat.map((a: any) => {
       const label = s.namaLatin + ':' + a.nomorAyat;
       let audioAttr = '';
       if(a.audioOptions) { for(const [key, url] of Object.entries(a.audioOptions)) { audioAttr += ' data-url-' + key + '="' + url + '"'; } }

       return `
       <div class="ayat-item" id="ayat-${a.nomorAyat}">
          <div class="ayat-meta-top">
              <span class="ayat-badge">${a.nomorAyat}</span>
              <div class="ayat-actions">
                  <button class="btn-action" onclick="playAyat(this, '${label}')" ${audioAttr}><i class="fas fa-play"></i></button>
                  <button class="btn-action" onclick="navigator.share({title:'QuranMu', text:'QS ${label}', url:window.location.href})"><i class="fas fa-share-alt"></i></button>
              </div>
          </div>
          <div class="ayat-arab" dir="rtl">${a.teksArab}</div>
          <div class="trans-block trans-latin">${a.teksLatin}</div>
          <div class="trans-block trans-id">${a.teksIndonesia}</div>
          <div class="trans-block trans-en">${a.teksInggris || ''}</div>
       </div>`;
    }).join('');

    const headerHtml = `
      <div style="text-align:center; padding:10px 0 30px; border-bottom:1px solid var(--border); margin-bottom:25px;">
         <h1 style="font-size:3rem; color:var(--primary); margin:0; font-family:'Amiri',serif;">${s.nama}</h1>
         <h2 style="font-size:1.8rem; color:var(--text-main); margin:5px 0;">${s.namaLatin}</h2>
         <p style="color:var(--text-muted); font-size:0.9rem;">${s.arti} • ${s.jumlahAyat} Ayat • ${s.tempatTurun}</p>
         <div style="margin-top:20px;"><button onclick="playAyat(this, 'Full ${s.namaLatin}')" data-url-05="${s.audioFull?.['05'] || ''}" style="padding:10px 25px; background:var(--bg-card); border:1px solid var(--primary); color:var(--primary); border-radius:30px; cursor:pointer; font-weight:bold;"><i class="fas fa-play-circle"></i> Putar Full Surat</button></div>
      </div>
      <div style="display:flex; justify-content:space-between; margin-bottom:30px;">
         ${s.suratSebelumnya ? `<a href="/${s.suratSebelumnya.nomor}" style="text-decoration:none; color:var(--text-muted); font-size:0.85rem; border:1px solid var(--border); padding:5px 12px; border-radius:20px;"><i class="fas fa-arrow-left"></i> ${s.suratSebelumnya.namaLatin}</a>` : '<div></div>'}
         ${s.suratSelanjutnya ? `<a href="/${s.suratSelanjutnya.nomor}" style="text-decoration:none; color:var(--text-muted); font-size:0.85rem; border:1px solid var(--border); padding:5px 12px; border-radius:20px;">${s.suratSelanjutnya.namaLatin} <i class="fas fa-arrow-right"></i></a>` : '<div></div>'}
      </div>
    `;

    return this._layout(headerHtml + ayatListHtml, s.namaLatin, ctx);
  },

  renderPage(ctx: ThemeContext) { return this.renderHome(ctx); },
  render404(ctx: ThemeContext) { return this._layout('404 Not Found', '404', ctx); }
};

export default LabMuQuran;