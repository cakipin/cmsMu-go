import { ThemeStructure, ThemeContext } from '../types';
import { css } from './style';
import { renderHeader } from './header';
import { renderFooter } from './footer';

const LabMuQuran: ThemeStructure = {
  name: 'LabMu Quran Platinum',
  version: '50.0-NO-CUTS',
  author: 'LabMu',

  _layout(content: string, title: string, ctx: ThemeContext) {
    return `
      <!DOCTYPE html>
      <html lang="id">
      <head>
        <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${title} - QuranMu</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <style>${css}</style>
      </head>
      <body>
        ${renderHeader(ctx)}

        <div id="qari-list" class="qari-popup" style="display:none; position:fixed; top:60px; right:20px; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; z-index:9999; box-shadow:0 10px 30px rgba(0,0,0,0.3); width:250px; overflow:hidden;">
            <div style="background:var(--primary); color:#fff; padding:10px 15px; font-weight:bold; font-size:0.9rem;">Pilih Qari</div>
            <div style="max-height:300px; overflow-y:auto;">
                <button onclick="window.selectQari('01', 'Abdullah Al-Juhany')" style="width:100%; text-align:left; padding:12px 15px; border:none; background:none; color:var(--text-main); cursor:pointer; border-bottom:1px solid var(--border);">1. Abdullah Al-Juhany</button>
                <button onclick="window.selectQari('02', 'Abdul Muhsin Al-Qasim')" style="width:100%; text-align:left; padding:12px 15px; border:none; background:none; color:var(--text-main); cursor:pointer; border-bottom:1px solid var(--border);">2. Abdul Muhsin Al-Qasim</button>
                <button onclick="window.selectQari('03', 'Abdurrahman As-Sudais')" style="width:100%; text-align:left; padding:12px 15px; border:none; background:none; color:var(--text-main); cursor:pointer; border-bottom:1px solid var(--border);">3. Abdurrahman As-Sudais</button>
                <button onclick="window.selectQari('04', 'Ibrahim Al-Dossari')" style="width:100%; text-align:left; padding:12px 15px; border:none; background:none; color:var(--text-main); cursor:pointer; border-bottom:1px solid var(--border);">4. Ibrahim Al-Dossari</button>
                <button onclick="window.selectQari('05', 'Misyari Rasyid Al-Afasy')" style="width:100%; text-align:left; padding:12px 15px; border:none; background:none; color:var(--text-main); cursor:pointer;">5. Misyari Rasyid (Default)</button>
            </div>
        </div>

        <div class="quran-container">
          <div class="content-area">${content}</div>
          ${renderFooter(ctx)}
        </div>
        ${this._scripts()}
      </body>
      </html>
    `;
  },

  _scripts() {
    return `
      <div id="toast" style="visibility:hidden; min-width:200px; background:#333; color:#fff; text-align:center; border-radius:8px; padding:10px; position:fixed; z-index:9999; left:50%; bottom:90px; transform:translateX(-50%); opacity:0; transition:0.3s;">Copied!</div>

      <script>
        // 1. STATE & UI
        window.state = {
            dark: null === 'true',
            latin: null !== 'false',
            id: null !== 'false',
            en: null === 'true',
            tajwid: null === 'true',
            qari: null || '05',
            qariName: null || 'Misyari Rasyid'
        };

        window.updateUI = function() {
            document.body.className = window.state.dark ? 'dark' : '';
            ['latin', 'id', 'en', 'tajwid'].forEach(function(k) {
                document.body.classList.toggle('show-' + k, window.state[k]);
                var btn = document.getElementById('btn-' + k);
                if(btn) btn.classList.toggle('active', window.state[k]);
            });
            var qLabel = document.getElementById('qari-label-desktop');
            if(qLabel) qLabel.innerText = window.state.qariName.split(' ')[0];
        };

        // 2. TOGGLE LOGIC
        window.toggleMode = function(key) {
            if(key === 'theme') { window.state.dark = !window.state.dark; (void 0); }
            else { window.state[key] = !window.state[key]; (void 0); }
            window.updateUI();
        };

        window.toggleQariMenu = function() {
            var list = document.getElementById('qari-list');
            if(list) list.style.display = (list.style.display === 'block') ? 'none' : 'block';
        };

        window.selectQari = function(val, name) {
            window.state.qari = val;
            window.state.qariName = name;
            (void 0);
            (void 0);
            window.showToast('Qari diganti ke: ' + name);
            var list = document.getElementById('qari-list');
            if(list) list.style.display = 'none';
            setTimeout(function() { location.reload(); }, 500);
        };

        window.toggleSidebar = function() {
            document.getElementById('mobile-sidebar').classList.toggle('open');
            document.getElementById('sidebar-overlay').classList.toggle('show');
        };

        // 3. AUDIO PLAYER LOGIC
        window.playAyat = function(btn, title) {
            var qariId = window.state.qari || '05';
            var audioData = {};

            // Cek apakah data audio bentuk string JSON atau object
            try {
                var raw = btn.getAttribute('data-audio');
                if(raw) audioData = JSON.parse(raw);
                else {
                    // Fallback ambil dari atribut data-url-XX (untuk kompatibilitas)
                    var urlAttr = btn.getAttribute('data-url-' + qariId);
                    if(urlAttr) audioData[qariId] = urlAttr;
                }
            } catch(e) { console.log(e); }

            var url = audioData[qariId];

            if (url) {
                var player = document.getElementById('main-player');
                var container = document.getElementById('player-container');
                container.style.display = 'flex';
                document.getElementById('player-title').innerText = title + ' (' + window.state.qariName + ')';

                player.src = url;
                player.play();
            } else {
                window.showToast('Audio Qari ini belum tersedia');
            }
        };

        window.closePlayer = function() {
            var p = document.getElementById('main-player');
            if(p) p.pause();
            document.getElementById('player-container').style.display='none';
        };

        // 4. SHARE & SEARCH
        window.showToast = function(msg) {
            var x=document.getElementById("toast");
            x.innerText=msg; x.style.visibility="visible"; x.style.opacity="1";
            setTimeout(()=>{x.style.visibility="hidden";x.style.opacity="0";},2000);
        };

        window.toggleShare = function(id) {
            var el = document.getElementById('share-pop-' + id);
            document.querySelectorAll('.share-popover').forEach(function(p) { if(p !== el) p.style.display = 'none'; });
            if(el) el.style.display = (el.style.display === 'block') ? 'none' : 'block';
        };

        window.shareAyat = function(platform, surahName, noAyat, arab, indo) {
            var url = window.location.origin + window.location.pathname + '#ayat-' + noAyat;
            var text = "QS. " + surahName + " [" + noAyat + "]\\n\\n" + arab + "\\n\\n" + indo + "\\n\\nLink: " + url;
            if (platform === 'wa') window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(text), '_blank');
            else if (platform === 'copy') {
                navigator.clipboard.writeText(text).then(function() { window.showToast('Teks disalin!'); });
            }
            document.querySelectorAll('.share-popover').forEach(function(p) { p.style.display = 'none'; });
        };

        // --- SEARCH ENGINE BARU ---
        window.handleSearch = function(event) {
            var keyword = document.getElementById('searchBox').value.trim();

            // JIKA TEKAN ENTER -> TEMATIK
            if (event && event.key === "Enter") {
                if (keyword.length < 3) return window.showToast('Minimal 3 huruf Om');
                var url = '/api/quran/tematik?q=' + encodeURIComponent(keyword);
                window.location.href = url;
                return;
            }

            // JIKA KETIK BIASA -> FILTER NAMA SURAT
            var cards = document.querySelectorAll('.surat-card');
            cards.forEach(function(el) {
                var name = el.getAttribute('data-name') || '';
                el.style.display = (keyword === '' || name.includes(keyword.toLowerCase())) ? 'flex' : 'none';
            });
        };

        // 5. KALENDER HIJRIAH (Dikembalikan)
        function getHijriString() {
            var today = new Date();
            var day = today.getDate(), month = today.getMonth(), year = today.getFullYear();
            var m = month + 1, y = year;
            if (m < 3) { y -= 1; m += 12; }
            var jd = Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + day + (2 - Math.floor(y/100) + Math.floor(Math.floor(y/100)/4)) - 1524;
            var z = jd - 1948084, cyc = Math.floor(z / 10631.0);
            z = z - 10631 * cyc;
            var j = Math.floor((z - 0.1335) / 354.366);
            var iy = 30 * cyc + j;
            z = z - Math.floor(j * 354.366 + 0.1335);
            var im = Math.floor((z + 28.5001) / 29.5);
            if (im == 13) im = 12;
            var id = z - Math.floor(29.5001 * im - 29);
            var iMonthNames = ["Muharram","Safar","Rabi'ul Awal","Rabi'ul Akhir","Jumadil Awal","Jumadil Akhir","Rajab","Sya'ban","Ramadhan","Syawal","Dzulkaidah","Dzulhijjah"];

            var adjustment = -1;
            var finalDay = id + adjustment;
            if (finalDay <= 0) { finalDay = 30 + finalDay; im--; if(im < 1) { im = 12; iy--; } }

            return finalDay + " " + iMonthNames[im - 1] + " " + iy;
        }

        window.updateHijriDate = function() {
             try {
                var h = getHijriString();
                var t = new Date();
                var m = t.toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'});
                var bD = document.getElementById('hijri-badge-desktop');
                if(bD) bD.innerHTML = '<div class="calendar-khgt">'+h+' H</div><div class="calendar-divider"></div><div class="calendar-masehi">'+m+'</div>';
            } catch(e) {}
        };

        document.addEventListener('DOMContentLoaded', function() {
            window.updateUI();
            window.updateHijriDate();
        });
      </script>

      <div class="sticky-player" id="player-container" style="display:none;">
          <div style="width:35px; height:35px; background:var(--primary); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff;"><i class="fas fa-play"></i></div>
          <div style="flex:1; overflow:hidden;">
             <span id="player-title" style="font-size:0.75rem; font-weight:bold; color:var(--text-main); display:block; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">Audio</span>
             <audio id="main-player" controls style="height:30px; width:100%;"></audio>
          </div>
          <button onclick="window.closePlayer()" style="background:none; border:none; color:var(--text-muted); cursor:pointer;"><i class="fas fa-times"></i></button>
      </div>
    `;
  },

  _applyTajwid(text: string) {
    if (!text) return '';
    return text
      .replace(/([\u064B\u064C\u064D])/g, '<span class="t-color t-ghunnah">$1</span>')
      .replace(/([\u0652])/g, '<span class="t-color t-qalqalah">$1</span>')
      .replace(/([\u0651])/g, '<span class="t-color t-ikhfa">$1</span>')
      .replace(/([\u064E\u064F\u0650])/g, '<span class="t-color t-idgham">$1</span>');
  },

  renderHome(ctx: ThemeContext) {
    const list = Array.isArray(ctx.data) ? ctx.data : [];
    return this._layout(`
      <div style="text-align:center; padding:30px 0;">
        <h1 style="font-family:'Amiri', serif; font-size:2.8rem; color:var(--primary); margin:0;">Al-Quran Digital</h1>
      </div>

      <div style="position:relative; margin-bottom:30px; z-index:10;">
        <input type="text" id="searchBox"
               placeholder="Cari surat... atau Enter untuk Cari Ayat (Tematik)"
               class="search-box"
               onkeyup="window.handleSearch(event)"
               autocomplete="off"
               style="width:100%; padding:15px; border-radius:12px; border:1px solid var(--border); background:var(--bg-card); color:var(--text-main);">
        <i class="fas fa-search" style="position:absolute; right:15px; top:18px; color:#ccc;"></i>
      </div>

      <div class="surat-grid">
        ${list.map((s: any) => `
          <a href="/api/quran/${s.nomor}" class="surat-card" data-name="${(s.nama_latin || s.namaLatin || '').toLowerCase()}">
            <div class="nomor-surat">${s.nomor}</div>
            <div style="flex:1;">
              <div style="font-weight:bold;">${s.nama_latin || s.namaLatin}</div>
              <div style="font-size:0.85rem; color:var(--text-muted);">${s.arti || ''}</div>
            </div>
            <div style="font-family:'Amiri', serif; font-size:1.4rem; color:var(--primary);">${s.nama}</div>
          </a>`).join('')}
      </div>
    `, 'Beranda', ctx);
  },

  // FUNGSI BARU UNTUK MENAMPILKAN HASIL D1
  renderSearch(results: any[], keyword: string, ctx: ThemeContext) {
    const html = `
      <div style="padding: 10px 0;">
        <div style="background: var(--bg-card); padding: 20px; border-radius: 15px; margin-bottom: 30px; border-left: 5px solid var(--primary);">
            <h2 style="margin:0; font-size: 1.2rem;">Hasil Pencarian Tematik</h2>
            <p style="margin: 5px 0 0; opacity: 0.7;">Kata kunci: <b>"${keyword}"</b></p>
            <div style="margin-top: 10px; font-size: 0.8rem; background: var(--primary); color: #fff; display: inline-block; padding: 2px 10px; border-radius: 10px;">
                ${results.length} Ayat Ditemukan
            </div>
        </div>

        ${results.map((a: any) => `
          <div class="search-item" style="background: var(--bg-card); padding: 25px; border-radius: 15px; margin-bottom: 20px; border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px dashed var(--border); padding-bottom: 10px;">
                <div style="font-weight: bold; color: var(--primary);">
                    <i class="fas fa-book-open"></i> QS. ${a.surah_id}:${a.nomor_ayat}
                </div>
                <a href="/api/quran/${a.surah_id}#ayat-${a.nomor_ayat}"
                   style="text-decoration: none; color: var(--text-muted); font-size: 0.8rem; background: var(--border); padding: 5px 12px; border-radius: 20px;">
                   Buka Surat &rarr;
                </a>
            </div>
            <div class="ayat-arab" dir="rtl" style="font-size: 2rem; line-height: 2.8; margin-bottom: 20px; text-align: right; font-family: 'Amiri', serif;">
                ${this._applyTajwid(a.teks_arab || a.teksArab)}
            </div>
            <div style="font-size: 0.95rem; color: var(--text-main); line-height: 1.7; font-style: italic;">
                "${a.teks_indonesia || a.teksIndonesia}"
            </div>
          </div>
        `).join('')}

        <div style="text-align: center; margin-top: 40px; padding-bottom: 40px;">
             <a href="/api/quran" style="text-decoration: none; color: var(--primary); font-weight: bold;">← Kembali ke Daftar Surat</a>
        </div>
      </div>
    `;
    return this._layout(html, `Cari: ${keyword}`, ctx);
  },

  renderSingle(ctx: ThemeContext) {
    const s = ctx.data;
    if (!s || !s.ayat) return this._layout('Not Found', 'Error', ctx);

    // Logic Audio Full
    let fullAudioAttrs = '';
    if (s.audioFull) {
        if (typeof s.audioFull === 'string') {
             fullAudioAttrs = ' data-audio=\'' + JSON.stringify({'05': s.audioFull}) + '\'';
        } else {
             fullAudioAttrs = ' data-audio=\'' + JSON.stringify(s.audioFull) + '\'';
        }
    }

    const ayatListHtml = s.ayat.map((a: any) => {
       const label = (s.namaLatin || s.nama_latin) + ':' + (a.nomorAyat || a.nomor_ayat);
       const cleanIndo = (a.teksIndonesia || a.teks_indonesia || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
       const cleanArab = (a.teksArab || a.teks_arab || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');

       let ayatAudioAttrs = '';
       // Support Format JSON string atau Object
       if (a.audioOptions) {
           let audioObj = typeof a.audioOptions === 'string' ? JSON.parse(a.audioOptions) : a.audioOptions;
           ayatAudioAttrs = ' data-audio=\'' + JSON.stringify(audioObj) + '\'';
       }

       return `
       <div class="ayat-item" id="ayat-${a.nomorAyat || a.nomor_ayat}">
          <div class="ayat-meta-top">
              <span class="ayat-badge">${a.nomorAyat || a.nomor_ayat}</span>
              <div class="ayat-actions" style="position:relative;">
                  <button class="btn-action" onclick="window.toggleShare('${a.nomorAyat || a.nomor_ayat}')"><i class="fas fa-share-alt"></i></button>
                  <div id="share-pop-${a.nomorAyat || a.nomor_ayat}" class="share-popover" style="display:none; position:absolute; right:0; top:40px; background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:8px; z-index:100; box-shadow:0 5px 15px rgba(0,0,0,0.2);">
                      <div style="display:flex; flex-direction:column; gap:5px;">
                          <button onclick="window.shareAyat('wa', '${s.namaLatin || s.nama_latin}', '${a.nomorAyat || a.nomor_ayat}', '${cleanArab}', '${cleanIndo}')" style="background:none; border:none; color:#25D366; cursor:pointer; text-align:left; font-weight:bold;"><i class="fab fa-whatsapp"></i> WA</button>
                          <button onclick="window.shareAyat('copy', '${s.namaLatin || s.nama_latin}', '${a.nomorAyat || a.nomor_ayat}', '${cleanArab}', '${cleanIndo}')" style="background:none; border:none; color:var(--primary); cursor:pointer; text-align:left; font-weight:bold;"><i class="fas fa-copy"></i> Salin</button>
                      </div>
                  </div>
                  <button class="btn-action" onclick="window.playAyat(this, '${label}')" ${ayatAudioAttrs}><i class="fas fa-play"></i></button>
              </div>
          </div>
          <div class="ayat-arab" dir="rtl">${this._applyTajwid(a.teksArab || a.teks_arab)}</div>
          <div class="trans-block trans-latin">${a.teksLatin || a.teks_latin}</div>
          <div class="trans-block trans-id">${a.teksIndonesia || a.teks_indonesia}</div>
          <div class="trans-block trans-en">${a.teksInggris || a.teks_inggris || ''}</div>
       </div>`;
    }).join('');

    const safeTurun = s.tempatTurun ? ' • ' + s.tempatTurun : '';
    const safeArti = s.arti || '';

    const headerHtml = `
      <div style="text-align:center; padding:10px 0 30px; border-bottom:1px solid var(--border); margin-bottom:25px;">
         <h1 style="font-size:3rem; color:var(--primary); margin:0; font-family:'Amiri',serif;">${s.nama}</h1>
         <h2 style="font-size:1.8rem;">${s.namaLatin || s.nama_latin}</h2>
         <p style="color:var(--text-muted); font-size:0.9rem;">${safeArti} • ${s.jumlahAyat || s.jumlah_ayat || '?'} Ayat${safeTurun}</p>
         <div style="margin-top:20px;">
            <button onclick="window.playAyat(this, 'Full ${s.namaLatin || s.nama_latin}')" ${fullAudioAttrs} style="padding:10px 25px; background:var(--bg-card); border:1px solid var(--primary); color:var(--primary); border-radius:30px; cursor:pointer; font-weight:bold;">
               <i class="fas fa-play-circle"></i> Putar Full Surat
            </button>
         </div>
      </div>
      <div style="display:flex; justify-content:space-between; margin-bottom:30px;">
         ${s.suratSebelumnya ? `<a href="/api/quran/${s.suratSebelumnya.slug || s.suratSebelumnya.nomor}" style="text-decoration:none; color:var(--text-muted); font-size:0.85rem; border:1px solid var(--border); padding:5px 12px; border-radius:20px;"><i class="fas fa-arrow-left"></i> ${s.suratSebelumnya.namaLatin}</a>` : '<div></div>'}
         ${s.suratSelanjutnya ? `<a href="/api/quran/${s.suratSelanjutnya.slug || s.suratSelanjutnya.nomor}" style="text-decoration:none; color:var(--text-muted); font-size:0.85rem; border:1px solid var(--border); padding:5px 12px; border-radius:20px;">${s.suratSelanjutnya.namaLatin} <i class="fas fa-arrow-right"></i></a>` : '<div></div>'}
      </div>
    `;

    return this._layout(headerHtml + ayatListHtml, s.namaLatin || s.nama_latin, ctx);
  },

  renderPage(ctx: ThemeContext) { return this.renderHome(ctx); },
  render404(ctx: ThemeContext) { return this._layout('404 Not Found', '404', ctx); }
};

export default LabMuQuran;