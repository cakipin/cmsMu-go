export const mediaLogic = {
    // State lokal
    mediaList: [],
    activeMediaItem: null,
    // Ditambahkan properti filename untuk menampung input rename
    activeMediaMeta: { alt: '', title: '', description: '', caption: '', filename: '' },
    isUploading: false,
    isSavingMeta: false,
    mediaSearchQuery: '',

    async loadMedia() {
        try {
            const token = '';
            if (!token) return;

            let res = await fetch('/api/media?t=' + Date.now(), { 
                headers: { 'Authorization': 'Bearer ' + token } 
            });
            let json = await res.json();
            
            let rawData = Array.isArray(json) ? json : (json.data || json.results || []);
            
            this.mediaList = rawData.filter(m => !m.key.endsWith('/'));
            
        } catch (e) { 
            console.error("Gagal load media:", e);
            this.mediaList = []; 
        }
    },

    setActiveItem(m) {
        this.activeMediaItem = m;
        // Mengambil nama file asli dari key (misal: 2026/02/gambar.jpg -> gambar.jpg)
        const currentFilename = m.key ? m.key.split('/').pop() : '';

        this.activeMediaMeta = {
            alt: m.alt || '',
            title: m.title || '',
            description: m.description || '',
            caption: m.caption || '',
            filename: currentFilename // Set nilai awal untuk input rename
        };
    },

    async deleteMedia(key) {
        if(!confirm('Hapus file ini permanen?')) return;
        
        let item = this.mediaList.find(i => i.key === key);
        let id = item ? item.id : null;

        if (!id) { alert('ID File tidak ditemukan. Coba refresh.'); return; }

        try { 
            const token = '';
            let res = await fetch('/api/media/' + id, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + token }
            }); 
            
            if(res.ok){
                this.activeMediaItem = null;
                await this.loadMedia();
            } else {
                throw new Error('Gagal');
            }
        } catch(e) { alert('Gagal hapus'); }
    },

    async saveMediaMeta() {
        if(!this.activeMediaItem) return;
        this.isSavingMeta = true;
        try { 
            const token = '';
            
            // Payload mencakup data meta standar dan newFilename untuk proses rename di backend
            const payload = {
                ...this.activeMediaMeta,
                newFilename: this.activeMediaMeta.filename
            };

            let res = await fetch('/api/media/' + this.activeMediaItem.id, {
                method: 'PUT', 
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                }, 
                body: JSON.stringify(payload)
            });
            
            if (res.ok) {
                alert('Tersimpan! (Halaman akan memuat ulang jika Anda melakukan rename)'); 
                // Jika terjadi rename, list perlu di-load ulang karena URL/Key berubah
                this.activeMediaItem = null;
                await this.loadMedia();
            } else {
                alert('Gagal simpan');
            }
        } catch (e) {
            console.error("Save Error:", e);
            alert('Terjadi kesalahan saat menyimpan.');
        } finally { 
            this.isSavingMeta = false; 
        }
    },

    async uploadMedia(e) {
        const files = e.target.files; 
        if(!files.length) return;
        
        this.isUploading = true; 
        const fd = new FormData();
        for(let i=0; i<files.length; i++) fd.append('file', files[i]);
        
        try { 
            const token = '';
            let res = await fetch('/api/media', {
                method: 'POST',
                headers: { 'Authorization': 'Bearer ' + token },
                body: fd
            }); 
            if(res.ok) await this.loadMedia(); 
        } finally { 
            this.isUploading = false; 
            e.target.value = ''; 
        }
    },

    get filteredMedia() {
        return (this.mediaList||[]).filter(m => 
            (m.key||'').toLowerCase().includes((this.mediaSearchQuery||'').toLowerCase())
        );
    }
};