export const postLogic = {
    postList: [],
    isLoading: false,

    /**
     * Memanggil API yang baru kita buat di posts.router.ts
     */
    async loadPosts() {
        this.isLoading = true;
        try {
            const token = '';
            // Path /api/posts sudah terdaftar di src/index.ts
            const res = await fetch('/api/posts', {
                headers: { 
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                }
            });

            if (!res.ok) throw new Error("Gagal mengambil data dari server");

            const data = await res.json();
            
            // Simpan hasil ke postList untuk di-looping di UI
            // Kita pastikan data adalah array agar tidak error saat x-for
            this.postList = Array.isArray(data) ? data : [];
            
            console.log('Posts successfully loaded:', this.postList.length, 'items');
        } catch (e) {
            console.error("Error loading posts:", e);
            this.postList = [];
        } finally {
            this.isLoading = false;
        }
    },

    /**
     * Helper untuk memformat tanggal agar tampil rapi di tabel
     */
    formatDate(dateStr) {
        if (!dateStr) return '-';
        const date = new Date(dateStr);
        return date.toLocaleDateString('id-ID', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
        });
    }
};