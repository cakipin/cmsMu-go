# ==============================================================================
# 🚀 CMSMu Serverless - Template Variabel Lingkungan (.env.example)
# Salin berkas ini ke .env untuk pengembangan lokal: cp .env.example .env
# ==============================================================================

# [Opsional] Konfigurasi GitHub OAuth untuk Keystatic / Git-based CMS Mode
KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_client_id_here
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
KEYSTATIC_SECRET=generate_a_random_32_characters_secret_string_here

# [Opsional] JWT Secret untuk autentikasi sesi lokal
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# [Opsional] URL Domain Utama CMSMu Anda
SITE_URL=https://your-domain.pages.dev
