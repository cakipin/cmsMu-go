# ==============================================================================
# CMSMu Cloud Native Environment Configuration Template
# ==============================================================================

# Authentication & Security (Wajib diganti saat inisiasi project baru)
# Generate dengan: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_min_64_chars

# Cloudflare D1 Database (Dikonfigurasi di wrangler.jsonc / dashboard Cloudflare)
# CLOUDFLARE_DATABASE_ID=

# Cloudflare R2 Storage (Dikonfigurasi di wrangler.jsonc)
# R2_BUCKET_NAME=

# Muhammadiyah ID SSO (Opsional)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:4321/api/users/sso/callback

# Environment Target
NODE_ENV=development
